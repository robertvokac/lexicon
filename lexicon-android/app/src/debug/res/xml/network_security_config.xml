<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: Android permits cleartext transport, while ServerUrl
     still refuses HTTP outside the emulator/loopback hosts until the person
     selects Allow HTTP for testing on the login screen. Release builds use
     src/main/res/xml/network_security_config.xml and remain HTTPS-only. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
